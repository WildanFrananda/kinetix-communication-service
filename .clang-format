# Google's C++ style, with the two changes CLAUDE.md asks for: four-space indentation, and a
# wider column limit.
#
# 100 columns rather than Google's 80 because this codebase names things in full —
# `IConversationRepository`, `std::expected<std::optional<domain::Conversation>, domain::CommunicationError>`
# — and at 80 those signatures wrap into shapes that hide where the arguments start.
BasedOnStyle: Google
IndentWidth: 4
AccessModifierOffset: -2
ColumnLimit: 100
# The hand style this codebase is written in: one parameter per line, and the closing bracket alone
# on its own line at the statement's indent. Google's default aligns continuations to the open
# bracket, which is what made 38 of 65 files read as unformatted when they were in fact tidied.
AlignAfterOpenBracket: BlockIndent
BinPackParameters: false
BinPackArguments: false
AllowAllParametersOfDeclarationOnNextLine: false
AllowAllArgumentsOnNextLine: false
PackConstructorInitializers: CurrentLine
ConstructorInitializerIndentWidth: 4
DerivePointerAlignment: false
PointerAlignment: Left
IncludeBlocks: Regroup
IncludeCategories:
  # C++ standard library first, then everything else angle-bracketed, then this project's own
  # headers. The file's own header is handled by clang-format's main-file rule and stays at the top.
  - Regex: '^<[a-z_]+>$'
    Priority: 2
  - Regex: '^<.*>$'
    Priority: 3
  - Regex: '^"(domain|ports)/'
    Priority: 4
  - Regex: '^"'
    Priority: 5
