{
    "version": 4,
    "configurations": [
        {
            "name": "kinetix-communication-service",
            "configurationProvider": "ms-vscode.cmake-tools",
            "compileCommands": "${workspaceFolder}/build-full/compile_commands.json",
            "compilerPath": "/usr/bin/clang++",
            "cStandard": "c17",
            "cppStandard": "c++23",
            "intelliSenseMode": "macos-clang-arm64",
            "includePath": [
                "${workspaceFolder}/include",
                "${workspaceFolder}/src",
                "${workspaceFolder}/build-full/src/adapters/contracts"
            ]
        }
    ]
}
